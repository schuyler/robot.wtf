[Unit]
Description=robot.wtf MCP Sidecar
After=network.target robot-otterwiki.service
Wants=network.target

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=/srv/app/src
EnvironmentFile=/srv/data/robot.env
ExecStart=/srv/app/venv/bin/python -m otterwiki_mcp.server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-mcp

[Install]
WantedBy=multi-user.target
