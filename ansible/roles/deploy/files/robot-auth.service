[Unit]
Description=robot.wtf Auth Service (Gunicorn)
After=network.target
Wants=network.target

[Service]
Type=notify
User=robot
Group=robot
WorkingDirectory=/srv/app/src
ExecStart=/srv/app/venv/bin/gunicorn \
    -c app/gunicorn.conf.py \
    app.auth_server:application
EnvironmentFile=/srv/data/auth.env
Environment=PLATFORM_DOMAIN=robot.wtf
Environment=SIGNING_KEY_PATH=/srv/data/signing_key.pem
Environment=CLIENT_JWK_PATH=/srv/data/client_jwk.json
Environment=ROBOT_DB_PATH=/srv/data/robot.db
Environment=GUNICORN_BIND=0.0.0.0:8003
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-auth

[Install]
WantedBy=multi-user.target
