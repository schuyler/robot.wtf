[Unit]
Description=robot.wtf Platform Service (Gunicorn)
After=network.target
Wants=network.target

[Service]
Type=notify
User=robot
Group=robot
WorkingDirectory=/srv/app/src
EnvironmentFile=/srv/data/robot.env
ExecStart=/srv/app/venv/bin/gunicorn \
    -c app/gunicorn.conf.py \
    app.platform_server:application
Environment=ROBOT_DB_PATH=/srv/data/robot.db
Environment=CLIENT_JWK_PATH=/srv/data/client_jwk.json
Environment=ROBOT_STATIC_DIR=/srv/static
Environment=WIKI_BASE=/srv/data/wikis
Environment=GUNICORN_BIND=0.0.0.0:8002
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-platform

[Install]
WantedBy=multi-user.target
