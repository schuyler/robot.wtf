#!/bin/bash
# robot.wtf per-wiki disk usage tracker.
# Measures each wiki directory and updates disk_usage_bytes in the database.

set -uo pipefail

DB="/srv/data/robot.db"

for wiki_dir in /srv/wikis/*/; do
    [ -d "$wiki_dir" ] || continue
    SLUG="$(basename "$wiki_dir")"
    SIZE="$(du -sb "$wiki_dir" 2>/dev/null | cut -f1)"
    [ -z "$SIZE" ] && continue
    sqlite3 "$DB" "UPDATE wikis SET disk_usage_bytes=$SIZE WHERE slug='$SLUG';"
done
